<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GroundSurf.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyName>GroundSurf</AssemblyName>
    <RootNamespace>GroundSurf</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Reference Include="System.Web.Extensions" />
    <Content Include="../Sources/landscape.html" Link="landscape.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Sources/LICENSE-original.txt" Link="LICENSE-original.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
